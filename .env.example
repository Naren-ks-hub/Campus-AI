# ==========================================================
# CampusAI - TiDB Cloud Serverless MySQL Configuration
# ==========================================================

# Server Port
PORT=3000

# TiDB Cloud Serverless Host (e.g., gateway01.us-east-1.prod.aws.tidbcloud.com)
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com

# TiDB Cloud Port (Default: 4000)
DB_PORT=4000

# TiDB Cloud User (e.g., xxxxxxxx.root)
DB_USER=root

# TiDB Cloud Database Password
DB_PASSWORD=your_tidb_password_here

# Database Name (Default: campusai_db or test)
DB_NAME=campusai_db

# Enable TLS / SSL encryption (Required for TiDB Cloud Serverless)
DB_SSL=true
